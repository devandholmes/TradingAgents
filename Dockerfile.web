# The dashboard server (tradingagents-web) with the built web UI: `docker compose up -d postgres web`.

FROM node:22-alpine AS webui
WORKDIR /webui
COPY webui/package.json webui/package-lock.json ./
RUN npm ci
COPY webui/ ./
RUN npm run build

FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TRADINGAGENTS_IN_DOCKER=1 \
    TRADINGAGENTS_WEB_HOST=0.0.0.0 \
    PATH="/opt/venv/bin:$PATH"

RUN useradd --create-home appuser \
 && install -d -m 0755 -o appuser -g appuser /home/appuser/.tradingagents \
 && python -m venv /opt/venv
WORKDIR /home/appuser/app

# Editable, so the app finds webui/dist next to the package (tradingagents/web/app.py).
COPY --chown=appuser:appuser . .
RUN pip install --no-cache-dir -e ".[web]"
COPY --from=webui --chown=appuser:appuser /webui/dist webui/dist

USER appuser
EXPOSE 8000
CMD ["tradingagents-web"]
